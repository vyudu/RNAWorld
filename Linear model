###############################################################
# Volume-Controlled Linear Model
# Forward-backward sweep optimization + constant-volume controls
# Plots for Vopt, Vmin, Vmax; A/B/C under Vopt; C(t) comparison;
# Random parameter search (finds parameter sets where Vopt beats all constant controls)
###############################################################
using Pkg
Pkg.activate(".")
using DifferentialEquations
using ForwardDiff
using Optim
using Random
using Plots

# -----------------------
# GLOBAL CONSTANTS
# -----------------------
const ϵ = 1e-8
const Vmin = 0.1
const Vmax = 100.0

# -----------------------
# RATE LAWS (NO Ki)
# -----------------------
rate1(A, V, k1) = V * k1 * (A / (V + ϵ))
rate3(C, V, k3) = V * k3 * (C / (V + ϵ))
# inhibition only via D and Kd
rate2(B, V, k2, D, Kd) = V * k2 * (B / (V + ϵ)) / (1 + (D / (V + ϵ)) / Kd)

# -----------------------
# STATE EQUATIONS
# n = [A, B, C]
# -----------------------
function state_dynamics!(du, n, p, t, λ, V, k1, k2, k3, D, Kd)
    A, B, C = n
    r1 = rate1(A, V, k1)
    r2 = rate2(B, V, k2, D, Kd)
    r3 = rate3(C, V, k3)
    du[1] = -r1
    du[2] =  r1 - r2
    du[3] =  r2 - r3
end

# -----------------------
# HAMILTONIAN
# -----------------------
function H(n, λ, V, k1, k2, k3, D, Kd)
    A, B, C = n
    L1, L2, L3 = λ
    r1 = rate1(A, V, k1)
    r2 = rate2(B, V, k2, D, Kd)
    r3 = rate3(C, V, k3)
    return L1*(-r1) + L2*(r1 - r2) + L3*(r2 - r3)
end

# -----------------------
# ADJOINT ODE (∂H/∂n)
# -----------------------
function adjoint_dynamics!(dl, λ, n, V, k1, k2, k3, D, Kd)
    dl .= -ForwardDiff.gradient(x -> H(x, λ, V, k1, k2, k3, D, Kd), n)
end

# -----------------------
# OPTIMAL CONTROL (PMP)
# -----------------------
function optimal_V(n, λ, k1, k2, k3, D, Kd)
    obj(V) = -H(n, λ, V, k1, k2, k3, D, Kd)   # minimize -H -> maximize H
    res = optimize(obj, Vmin, Vmax, Brent())
    return clamp(Optim.minimizer(res), Vmin, Vmax)
end

# -----------------------
# CONSTANT CONTROLS
# -----------------------
const_control_Vmax(n, λ, k1, k2, k3, D, Kd) = Vmax
const_control_Vmin(n, λ, k1, k2, k3, D, Kd) = Vmin
const_control_Vmean(n, λ, k1, k2, k3, D, Kd) = (Vmin + Vmax)/2

# -----------------------
# FORWARD-BACKWARD SWEEP
# -----------------------
"""
forward_backward_sweep(n0, λT, tspan, tsteps; k1,k2,k3,D,Kd, control_update)
returns: sol_n, sol_λ, V_values
- sol_n: solution object for forward state (callable)
- sol_λ: solution object for backward adjoint (callable, saved on reversed grid)
- V_values: array of V(t) used (length == length(tsteps))
"""
function forward_backward_sweep(n0, λT, tspan, tsteps;
                                k1, k2, k3, D, Kd,
                                control_update = (n,λ,k1,k2,k3,D,Kd)->optimal_V(n,λ,k1,k2,k3,D,Kd),
                                sweeps::Int=20)

    Nt = length(tsteps)
    V_values = fill((Vmin + Vmax)/2, Nt)
    sol_n = nothing
    sol_λ = nothing

    for sweep in 1:sweeps
        # Forward ODE (uses current V_values)
        function forward_ode!(du, u, p, t)
            idx = findfirst(x -> x ≥ t, tsteps)
            idx = clamp(idx, 1, Nt)
            V = V_values[idx]
            # pass nothing for λ argument (not used)
            state_dynamics!(du, u, p, t, nothing, V, k1, k2, k3, D, Kd)
        end
        prob_fwd = ODEProblem(forward_ode!, n0, tspan)
        sol_n = solve(prob_fwd, Tsit5(), saveat=tsteps)

        # Backward ODE for adjoint (integrate from t_f -> t_0)
        function backward_ode!(dl, λ, p, t)
            # find index from reversed timepoints
            idx = findfirst(x -> x ≥ t, reverse(tsteps))
            idx = clamp(idx, 1, Nt)
            n_at = sol_n(tsteps[end - idx + 1])
            V = V_values[end - idx + 1]
            adjoint_dynamics!(dl, λ, n_at, V, k1, k2, k3, D, Kd)
        end
        prob_bwd = ODEProblem(backward_ode!, λT, (tspan[2], tspan[1]))
        sol_λ = solve(prob_bwd, Tsit5(), saveat=reverse(tsteps))

        # Update control pointwise using current forward & backward solutions
        for (i, t) in enumerate(tsteps)
            n_t = sol_n(t)
            # sol_λ is saved on reversed grid; adjoint at time t is sol_λ(t_f - t + t0?) 
            # We saved with saveat=reverse(tsteps) so sol_λ(tspan[2] - t) returns adjoint at t
            λ_t = sol_λ(tspan[2] - t)
            V_values[i] = control_update(n_t, λ_t, k1, k2, k3, D, Kd)
        end
    end

    return sol_n, sol_λ, V_values
end

# -----------------------
# RUN SIMULATION & RETURN MAX C FOR ALL CONTROLS
# params = (k1,k2,k3,Kd,D)
# -----------------------
function run_main_simulation_for_params(params; tspan=(0.0,3.0), Nt=300, sweeps=20)
    k1, k2, k3, Kd, D = params
    tsteps = range(tspan[1], tspan[2], length=Nt)
    n0 = [200.0, 0.0, 0.0]
    λT = [0.0, 0.0, 1.0]

    # Optimal control
    sol_opt, sol_λ_opt, V_opt = forward_backward_sweep(n0, λT, tspan, tsteps;
                                                      k1=k1,k2=k2,k3=k3,D=D,Kd=Kd,
                                                      control_update=(n,λ,k1,k2,k3,D,Kd)->optimal_V(n,λ,k1,k2,k3,D,Kd),
                                                      sweeps=sweeps)
    C_opt = [sol_opt(t)[3] for t in tsteps]
    maxC_opt = maximum(C_opt)

    # Constant Vmax
    sol_Vmax, _, Vvals_Vmax = forward_backward_sweep(n0, λT, tspan, tsteps;
                                                     k1=k1,k2=k2,k3=k3,D=D,Kd=Kd,
                                                     control_update=(n,λ,k1,k2,k3,D,Kd)->const_control_Vmax(n,λ,k1,k2,k3,D,Kd),
                                                     sweeps=sweeps)
    C_Vmax = [sol_Vmax(t)[3] for t in tsteps]
    maxC_Vmax = maximum(C_Vmax)

    # Constant Vmin
    sol_Vmin, _, Vvals_Vmin = forward_backward_sweep(n0, λT, tspan, tsteps;
                                                     k1=k1,k2=k2,k3=k3,D=D,Kd=Kd,
                                                     control_update=(n,λ,k1,k2,k3,D,Kd)->const_control_Vmin(n,λ,k1,k2,k3,D,Kd),
                                                     sweeps=sweeps)
    C_Vmin = [sol_Vmin(t)[3] for t in tsteps]
    maxC_Vmin = maximum(C_Vmin)

    # Constant Vmean
    sol_Vmean, _, Vvals_Vmean = forward_backward_sweep(n0, λT, tspan, tsteps;
                                                       k1=k1,k2=k2,k3=k3,D=D,Kd=Kd,
                                                       control_update=(n,λ,k1,k2,k3,D,Kd)->const_control_Vmean(n,λ,k1,k2,k3,D,Kd),
                                                       sweeps=sweeps)
    C_Vmean = [sol_Vmean(t)[3] for t in tsteps]
    maxC_Vmean = maximum(C_Vmean)

    return Dict(
        :tsteps => tsteps,
        :sol_opt => sol_opt, :V_opt => V_opt, :C_opt => C_opt, :maxC_opt => maxC_opt,
        :sol_Vmax => sol_Vmax, :C_Vmax => C_Vmax, :maxC_Vmax => maxC_Vmax,
        :sol_Vmin => sol_Vmin, :C_Vmin => C_Vmin, :maxC_Vmin => maxC_Vmin,
        :sol_Vmean => sol_Vmean, :C_Vmean => C_Vmean, :maxC_Vmean => maxC_Vmean
    )
end

# -----------------------
# PLOTTING UTILITIES
# -----------------------
function make_plots(result_dict; title_suffix = "")
    tsteps = result_dict[:tsteps]

    # Plot Vopt and horizontal lines for Vmin and Vmax
    pV = plot(tsteps, result_dict[:V_opt], label="V_opt(t)", lw=2)
    plot!(pV, [first(tsteps), last(tsteps)], [Vmin, Vmin], label="Vmin", lw=2, ls=:dash)
    plot!(pV, [first(tsteps), last(tsteps)], [Vmax, Vmax], label="Vmax", lw=2, ls=:dashdot)
    xlabel!(pV, "Time"); ylabel!(pV, "Volume V(t)")
    title!(pV, "Volume control: V_opt vs Vmin/Vmax $title_suffix")

    # Plot A,B,C for Vopt
    sol_opt = result_dict[:sol_opt]
    A_opt = [sol_opt(t)[1] for t in tsteps]
    B_opt = [sol_opt(t)[2] for t in tsteps]
    C_opt = result_dict[:C_opt]
    pABC = plot(tsteps, A_opt, label="A (Vopt)", lw=2)
    plot!(pABC, tsteps, B_opt, label="B (Vopt)", lw=2)
    plot!(pABC, tsteps, C_opt, label="C (Vopt)", lw=2)
    xlabel!(pABC, "Time"); ylabel!(pABC, "Concentration")
    title!(pABC, "A, B, C vs Time under V_opt $title_suffix")

    # Plot comparison of C(t) for controls
    pC = plot(tsteps, C_opt, label="C (Vopt)", lw=2)
    plot!(pC, tsteps, result_dict[:C_Vmax], label="C (Vmax)", lw=2, ls=:dash)
    plot!(pC, tsteps, result_dict[:C_Vmin], label="C (Vmin)", lw=2, ls=:dot)
    plot!(pC, tsteps, result_dict[:C_Vmean], label="C (Vmean)", lw=2, ls=:dashdot)
    xlabel!(pC, "Time"); ylabel!(pC, "Concentration C")
    title!(pC, "C(t) under different controls $title_suffix")

    # layout
    plot(pV, pABC, pC, layout=(3,1), size=(900,1000))
end

