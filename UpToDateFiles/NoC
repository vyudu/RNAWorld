# =========================
# RATE LAWS (molecule-number form)
# =========================
rate1(A, C, V) = V * k1 * (A / (V + ϵ))  # simplifies to k1*A but keep your structure
rate2(B, V, D) = V * k2 * (B / (V + ϵ)) / (1 + (D / (V + ϵ)) / Kd)
rate3(C, V)    = V * k3 * (C / (V + ϵ))

# =========================
# STATE DYNAMICS: n = [A,B,C]
# =========================
function state_dynamics!(du, n, p, t, λ, V, D)
    A, B, C = n
    r1 = rate1(A, C, V)
    r2 = rate2(B, V, D)
    r3 = rate3(C, V)
    du[1] = -r1
    du[2] =  r1 - r2
    du[3] =  r2 - r3
end

# =========================
# HAMILTONIAN
# =========================
function H(n, λ, V, D)
    A, B, C = n
    L1, L2, L3 = λ
    r1 = rate1(A, C, V)
    r2 = rate2(B, V, D)
    r3 = rate3(C, V)
    return L1 * (-r1) + L2 * (r1 - r2) + L3 * (r2 - r3)
end

# =========================
# ADJOINT DYNAMICS
# =========================
function adjoint_dynamics!(dl, λ, n, V, D)
    dl .= -ForwardDiff.gradient(nn -> H(nn, λ, V, D), n)
end

# =========================
# OPTIMAL CONTROL: argmax_V H
# =========================
function optimal_V(n, λ)
    obj(V) = -H(n, λ, V, D)  # minimize -H = maximize H
    res = optimize(obj, Vmin, Vmax, Brent())
    Vopt = Optim.minimizer(res)
    return clamp(Vopt, Vmin, Vmax)
end

# =========================
# FORWARD-BACKWARD SWEEP
# =========================
function forward_backward_sweep(n0, λT, tspan, tsteps; control_update=optimal_V, iters=50)
    V_vals = fill((Vmin + Vmax) / 2, length(tsteps))
    sol_n, sol_λ = nothing, nothing

    for sweep in 1:iters
        println("Sweep $sweep")

        λ_dummy = zeros(3)

        # forward solve
        function forward_ode!(du, u, p, t)
            idx = findfirst(x -> x ≥ t, tsteps)
            state_dynamics!(du, u, p, t, λ_dummy, V_vals[idx], D)
        end
        prob_fwd = ODEProblem(forward_ode!, n0, tspan)
        sol_n = solve(prob_fwd, Tsit5(), saveat=tsteps)

        # backward solve
        function backward_ode!(dl, l, p, t)
            idx = findfirst(x -> x ≥ t, tsteps)
            adjoint_dynamics!(dl, l, sol_n(t), V_vals[idx], D)
        end
        prob_bwd = ODEProblem(backward_ode!, λT, (tspan[2], tspan[1]))
        sol_λ = solve(prob_bwd, Tsit5(), saveat=reverse(tsteps))

        # update control
        for (i, t) in enumerate(tsteps)
            V_vals[i] = control_update(sol_n(t), sol_λ(t))
        end
    end

    return sol_n, sol_λ, V_vals
end

# =========================
# GENERATE SOLUTIONS (AND KEEP Vopt CONSISTENT)
# =========================
function generate_solutions(n0, λT, tspan, tsteps)
    sol_opt, _, Vopt = forward_backward_sweep(n0, λT, tspan, tsteps)

    sol_Vmax, _, _  = forward_backward_sweep(n0, λT, tspan, tsteps; control_update=Returns(Vmax))
    sol_Vmin, _, _  = forward_backward_sweep(n0, λT, tspan, tsteps; control_update=Returns(Vmin))
    sol_Vmean, _, _ = forward_backward_sweep(n0, λT, tspan, tsteps; control_update=Returns((Vmin + Vmax) / 2))

    return (; opt=sol_opt, max=sol_Vmax, min=sol_Vmin, mean=sol_Vmean, Vopt=Vopt)
end

