# =========================
# OPTIONAL: Monte Carlo search (kept, but won’t break your main figure)
# =========================
function monte_carlo_PMP_maxC(n_trials=15)
    successes = []

    function random_parameters_PMP()
        k1 = 10^(rand(-1.0:0.05:1.0))
        k2 = 10^(rand(-1.0:0.05:1.0))
        k3 = 10^(rand(-1.0:0.05:1.0))
        D  = 10^(rand(0.0:0.05:2.0))
        Kd = 10^(rand(-1.0:0.05:1.0))
        return k1, k2, k3, D, Kd
    end

    for trial in 1:n_trials
        println("\n🧪 Trial $trial / $n_trials")

        k1r, k2r, k3r, Dr, Kdr = random_parameters_PMP()

        global k1 = k1r
        global k2 = k2r
        global k3 = k3r
        global D  = Dr
        global Kd = Kdr

        try
            sol_opt, _, _  = forward_backward_sweep(n0, λT, tspan, tsteps)
            sol_Vmax, _, _ = forward_backward_sweep(n0, λT, tspan, tsteps; control_update=Returns(Vmax))
            sol_Vmin, _, _ = forward_backward_sweep(n0, λT, tspan, tsteps; control_update=Returns(Vmin))
            sol_Vmean, _, _= forward_backward_sweep(n0, λT, tspan, tsteps; control_update=Returns((Vmin+Vmax)/2))

            Copt  = maximum([sol_opt(t)[3]   for t in tsteps])
            Cmax  = maximum([sol_Vmax(t)[3]  for t in tsteps])
            Cmin  = maximum([sol_Vmin(t)[3]  for t in tsteps])
            Cmean = maximum([sol_Vmean(t)[3] for t in tsteps])

            if Copt > Cmax && Copt > Cmin && Copt > Cmean
                println("✅ SUCCESS: PMP gives largest C")
                push!(successes, (params=(k1r,k2r,k3r,Dr,Kdr), Copt=Copt, Cmax=Cmax, Cmin=Cmin, Cmean=Cmean))
            else
                println("⚪ No dominance")
            end
        catch e
            println("❌ Failed trial: ", e)
        end
    end

    return successes
end

