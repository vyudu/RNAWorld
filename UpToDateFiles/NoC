using DifferentialEquations, Optim, Plots, Statistics

# ----------------------------------------------------------
# Constant V forward simulation (matches your forward_ode! idea)
# ----------------------------------------------------------
function solve_forward_constantV(Vconst, n0, tspan, tsteps; D=D)
    λ_dummy = zeros(3)  # unused by state_dynamics!, but keep signature identical
    function forward_ode!(du, u, p, t)
        state_dynamics!(du, u, p, t, λ_dummy, Vconst, D)
    end
    prob = ODEProblem(forward_ode!, n0, tspan)
    sol  = solve(prob, Tsit5(), saveat=tsteps)
    return sol
end

function maxC_constantV_like_main(Vconst, n0, tspan, tsteps; D=D)
    sol = solve_forward_constantV(Vconst, n0, tspan, tsteps; D=D)
    return maximum(sol[3, :])
end

# ----------------------------------------------------------
# Vopt maxC with bounds [Vlo, Vhi] (PMP via forward_backward_sweep)
# ----------------------------------------------------------
function maxC_Vopt_with_bounds(Vlo, Vhi, n0, λT, tspan, tsteps; iters=100)
    oldVmin = Vmin
    oldVmax = Vmax
    try
        global Vmin = Vlo
        global Vmax = Vhi

        sol_opt, _, _ = forward_backward_sweep(
            n0, λT, tspan, tsteps;
            control_update = optimal_V,
            iters = iters
        )
        Cvals = [sol_opt(t)[3] for t in tsteps]
        return maximum(Cvals)
    finally
        global Vmin = oldVmin
        global Vmax = oldVmax
    end
end

# ----------------------------------------------------------
# Build updated Fig 1(c)
# ----------------------------------------------------------
function plot_constV_curve_plus_Vopt_segments(n0, λT, tspan, tsteps;
                                              ngrid=150,
                                              iters_opt=100,
                                              step=10.0,
                                              savebase="Figure1c_constVcurve_plus_VoptSegments")

    Vlo = Vmin
    Vhi = Vmax

    # Constant-V sweep (forward simulations)
    Vs = collect(range(Vlo, Vhi, length=ngrid))
    Cs = similar(Vs, Float64)

    @info "Computing constant-V curve via forward simulations" ngrid
    for (i, V) in enumerate(Vs)
        Cs[i] = maxC_constantV_like_main(V, n0, tspan, tsteps; D=D)
    end

    # Plot base curve (no legend)
    default(fontfamily="Helvetica", framestyle=:box, linewidth=2,
            guidefontsize=10, tickfontsize=9, titlefontsize=11)

    p = plot(
        Vs, Cs,
        lw=2.5,
        label=false,
        xlabel="Volume V (constant)",
        ylabel="maxₜ C(t)",
        title="Stationary volume performance + Vopt bound benchmarks",
        legend=false
    )

    # Vopt horizontal segments: [Vmin, Vhi], where Vhi = Vmax, Vmax-step, ..., Vmin
    Vhis = collect(Vhi:-step:Vlo)
    if last(Vhis) != Vlo
        push!(Vhis, Vlo)  # ensure we end exactly at Vmin
    end

    @info "Computing Vopt segments (PMP forward-backward sweep)" length(Vhis) iters_opt step

    seg_vals = Vector{Tuple{Float64,Float64}}()  # (Vhi, Copt)
    for Vtop in Vhis
        Copt = maxC_Vopt_with_bounds(Vlo, Vtop, n0, λT, tspan, tsteps; iters=iters_opt)
        push!(seg_vals, (Vtop, Copt))

        # horizontal segment from x=Vmin to x=Vtop at y=Copt
plot!(
    p,
    [Vlo, Vtop], [Copt, Copt],
    lw=2.2,
    color=:orange,
    label=false
)

    end

    display(p)
    savefig(p, savebase * ".png")
    savefig(p, savebase * ".pdf")

    println("\n=== Vopt segment values (bounds [Vmin, Vhi]) ===")
    for (Vtop, Copt) in seg_vals
        println("[", Vlo, ", ", Vtop, "]  maxC = ", Copt)
    end

    return p, (Vs=Vs, Cs=Cs, segments=seg_vals)
end

