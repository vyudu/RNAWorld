############################################################
# Monte Carlo search using PMP optimizer
# Metric: maximum C(t)
############################################################
function monte_carlo_PMP_maxC(n_trials=20)
    successes = []

    function random_parameters_PMP()
    k1 = 10^(rand(-1.0:0.05:1.0))   # range ~0.1–10
    k2 = 10^(rand(-1.0:0.05:1.0))
    k3 = 10^(rand(-1.0:0.05:1.0))
    D  = 10^(rand(0.0:0.05:2.0))    # inhibitor level
    Kd = 10^(rand(-1.0:0.05:1.0))   # inhibition strength
    return k1, k2, k3, D, Kd
end

    for trial in 1:n_trials
        println("\n🧪 Trial $trial / $n_trials")

        # Sample random parameters
        k1, k2, k3, D_trial, Kd_trial = random_parameters_PMP()

        # Update globals used in rate laws
        global k1 = k1
        global k2 = k2
        global k3 = k3
        global D  = D_trial
        global Kd = Kd_trial

        try
            # PMP optimal control
            sol_opt, _, _ =
                forward_backward_sweep(n0, λT, tspan, tsteps)

            # Constant controls
            sol_Vmax, _, _ =
                forward_backward_sweep(n0, λT, tspan, tsteps;
                                       control_update=Returns(Vmax))

            sol_Vmin, _, _ =
                forward_backward_sweep(n0, λT, tspan, tsteps;
                                       control_update=Returns(Vmin))

            sol_Vmean, _, _ =
                forward_backward_sweep(n0, λT, tspan, tsteps;
                                       control_update=Returns((Vmin+Vmax)/2))

            # Metric: maximum C(t)
            Copt  = maximum([sol_opt(t)[3]  for t in tsteps])
            Cmax  = maximum([sol_Vmax(t)[3] for t in tsteps])
            Cmin  = maximum([sol_Vmin(t)[3] for t in tsteps])
            Cmean = maximum([sol_Vmean(t)[3] for t in tsteps])

            # Record only if PMP dominates all constants
            if Copt > Cmax && Copt > Cmin && Copt > Cmean
                println("✅ SUCCESS: PMP gives largest C")
                push!(successes, (
                    params = (k1, k2, k3, D_trial, Kd_trial),
                    Copt   = Copt,
                    Cmax   = Cmax,
                    Cmin   = Cmin,
                    Cmean  = Cmean
                ))
            else
                println("⚪ No dominance")
            end

        catch e
            println("❌ Failed trial: ", e)
        end
    end

    return successes
end



