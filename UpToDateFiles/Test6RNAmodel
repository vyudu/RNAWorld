# ---------- Parameter generator (must exist before finder) ----------
function random_parameters_big()
    # upstream: slower + broader so oscillations matter more
    k1 = 10^(rand(-3.0:0.01:-0.5))   # 0.001 – 0.3
    k2 = 10^(rand(-3.0:0.01:-0.3))   # 0.001 – 0.5
    k3 = 10^(rand(-3.0:0.01:-0.3))   # 0.001 – 0.5
    k4 = 10^(rand(-3.0:0.01:-0.3))   # 0.001 – 0.5
    k5 = 10^(rand(-3.0:0.01:-0.5))   # 0.001 – 0.3

    # RNA production term (VERY important for oscillation advantage)
    c6 = 10^(rand(1.0:0.01:4.0))     # 10 – 10,000

    # strong inhibition
    Kd = 10^(rand(-4.0:0.01:0.5))    # 1e-4 – 3.0

    # low drain so periodic bursts accumulate
    D1 = 10^(rand(-4.0:0.01:0.3))    # 1e-4 – 2.0

    return (k1, k2, k3, k4, k5, c6, Kd, D1)
end


# ---------- Finder: Vopt steady > max constant steady + margin ----------
function find_params_where_Vopt_beats_all_constants(;
        max_tries::Int=400,
        margin::Float64=1.0,
        Vgrid_len::Int=60,
        periodic_tol::Float64=1e-9,
        maxsteps_opt::Int=900,
        verbose::Bool=true
    )

    for trial in 1:max_tries
        p = random_parameters_big()

        # --- constant-V scan on [Vmin, Vmax] ---
        Vgrid = collect(range(Vmin, Vmax; length=Vgrid_len))
        zV = Float64[]
        for V in Vgrid
            solV = simulate_constant(p, n0, tspan_long, V; abstol=1e-8, reltol=1e-8)  # NOTE: V is positional
            push!(zV, window_average_RNA(solV; t1=1000.0, t2=1400.0))
        end

        zConst_max, idx = findmax(zV)
        Vbest_const = Vgrid[idx]

        # --- optimized oscillatory control over full clamp ---
        (Aopt, ωopt, ϕopt), zVopt_full, _ = optimize_steady_sinusoidal_bounds(
            p;
            Vlo=Vmin,
            Vhi=Vmax,
            periodic_tol=periodic_tol,
            maxsteps=maxsteps_opt,
            do_local_refine=true
        )

        if zVopt_full > zConst_max + margin
            if verbose
                println("\n================ SUCCESS =================")
                println("Trial number        : $trial")
                println("Best constant V*     : $(round(Vbest_const, digits=4))")
                println("Best constant RNA    : $(round(zConst_max, digits=6))")
                println("Vopt (A,ω,ϕ)         : A=$(round(Aopt,digits=6)), ω=$(round(ωopt,digits=6)), ϕ=$(round(ϕopt,digits=6))")
                println("Vopt steady RNA      : $(round(zVopt_full, digits=6))")
                println("Margin (Vopt-Const)  : $(round(zVopt_full - zConst_max, digits=6))")

                println("\nParameters tuple (k1,k2,k3,k4,k5,c6,Kd,D1):")
                println(p)

                println("\nParameters (pretty):")
                println("k1=$(p[1])")
                println("k2=$(p[2])")
                println("k3=$(p[3])")
                println("k4=$(p[4])")
                println("k5=$(p[5])")
                println("c6=$(p[6])")
                println("Kd=$(p[7])")
                println("D1=$(p[8])")
                println("=========================================\n")
            end

            return p, (Aopt, ωopt, ϕopt), zVopt_full, Vbest_const, zConst_max
        end
    end

    error("❌ No parameter set found after $max_tries tries. Increase max_tries, widen parameter ranges, or lower margin.")
end


# ---------- Run the search and overwrite params_example ----------
p_found, (A_found, ω_found, ϕ_found), zVopt_found, Vbest_const, zConst_max =
    find_params_where_Vopt_beats_all_constants(
        max_tries = 400,
