    Vvec = collect(Vgrid)
    zV = Vector{Float64}(undef, length(Vvec))
    for (i, V) in enumerate(Vvec)
        sol = simulate_constant(p, n0, tspan_long, V; abstol=1e-8, reltol=1e-8)
        zV[i] = window_average_RNA(sol; t1=1000.0, t2=1400.0)
    end

    # Vopt within [Vmin, Vmax]
    (_, _, _), zVopt_full, _ = optimize_steady_sinusoidal_bounds(
        p; Vlo=Vmin, Vhi=Vmax, periodic_tol=periodic_tol, maxsteps=1200, do_local_refine=true
    )

    # Vopt within [Vmin, Vmean]
    (_, _, _), zVopt_low, _ = optimize_steady_sinusoidal_bounds(
        p; Vlo=Vmin, Vhi=Vmean, periodic_tol=periodic_tol, maxsteps=1200, do_local_refine=true
    )

    # Vopt within [Vmean, Vmax]   <-- NEW requested line
    (_, _, _), zVopt_high, _ = optimize_steady_sinusoidal_bounds(
        p; Vlo=Vmean, Vhi=Vmax, periodic_tol=periodic_tol, maxsteps=1200, do_local_refine=true
    )

    # Plot with explicit label to avoid "y1"
    plt = plot(
        Vvec, zV;
        lw=3,
        label="Constant V curve",
        xlabel="Fixed Volume V",
        ylabel="Steady-state RNA (avg 1000–1400)",
        title="Fig 2a: Steady-state RNA vs Fixed Volume"
    )

    hline!(plt, [zVopt_full], lw=2, ls=:dash,
           label="Vopt steady (Vmin–Vmax): $(round(zVopt_full,digits=3))")
    hline!(plt, [zVopt_low],  lw=2, ls=:dot,
           label="Vopt steady (Vmin–Vmean): $(round(zVopt_low,digits=3))")
    hline!(plt, [zVopt_high], lw=2, ls=:dashdot,
           label="Vopt steady (Vmean–Vmax): $(round(zVopt_high,digits=3))")

    return plt, Vvec, zV, zVopt_full, zVopt_low, zVopt_high
end


# ============================================================
# 4D scatter (UPDATED & more robust):
#   axes = (A, ω, ϕ)
#   color = steady-state RNA
#
# Why your old 4D might “not work”:
# - ω too large => period T too small; solver can miss fast oscillations
# - not enough resolution -> periodic check fails -> NaNs everywhere
#
# Fixes:
# - use abstol/reltol and add max step controls
# - score still uses periodic-if-converged else 1000–1400 window
# - choose ω grid logspace but not insanely dense
# ============================================================
function fig4d_A_omega_phi_scatter(p;
    A_vals = range(0.0, (Vmax - Vmin)/2; length=11),
    ω_vals = logspace10(0.01, 100.0, 28),            # LOG ω up to 100
    ϕ_vals = range(0.0, 2π; length=24),
    periodic_tol = 1e-9,
    Vlo = Vmin,
    Vhi = Vmax,
    verbose=false)

    As  = Float64[]
    Ws  = Float64[]
    Phs = Float64[]
    Zs  = Float64[]

    for A in A_vals
        for ω in ω_vals
            for ϕ in ϕ_vals
                sol = simulate_sinusoidal_bounds(
                    p, n0, tspan_long, A, ω, ϕ;
                    Vlo=Vlo, Vhi=Vhi,
                    abstol=1e-6, reltol=1e-6
                )
                if sol.retcode != :Success
                    continue
                end

                z = steady_state_score(sol, ω; periodic_tol=periodic_tol,
                                       use_periodic=true, fallback_window=true)
                if isfinite(z)
                    push!(As, A)
                    push!(Ws, ω)
                    push!(Phs, ϕ)
                    push!(Zs, z)
                end
            end
        end
    end

    if length(Zs) == 0
        error("4D scatter produced no finite points. Try loosening periodic_tol (e.g., 1e-7) or reducing ω_max.")
    end

    plt = scatter3d(
        As, Ws, Phs;
        marker_z = Zs, ms = 5,
        xlabel = "A (amplitude)",
        ylabel = "ω (angular velocity)",
        zlabel = "ϕ (phase)",
        title  = "Fig 2b (4D): (A, ω, ϕ) colored by steady-state RNA",
        colorbar_title = "RNA steady avg",
        size = (1200, 850),
        right_margin = 22mm,
        left_margin  = 10mm,
        bottom_margin = 10mm,
        top_margin = 10mm,
        guidefontsize = 12,
        tickfontsize = 10,
        colorbar_tickfontsize = 9,
        legend = false,
        camera = (45, 25)
    )

    # ω is log-spaced; show it better if you want (optional):
    # Plots.jl doesn't truly do log axis in 3D, but you can transform ω yourself.
    # For now keep raw ω to match your PI’s axis request.

    return plt, As, Ws, Phs, Zs
end


# ============================================================
# Combined figure: Fig 2a (left) + Fig 2b/4D (right)
# ============================================================
function fig2a_and_4d_side_by_side(p;
    Vgrid = range(Vmin, Vmax; length=60),
    A_vals = range(0.0, (Vmax - Vmin)/2; length=11),
    ω_vals = logspace10(0.01, 100.0, 28),
    ϕ_vals = range(0.0, 2π; length=24),
    periodic_tol = 1e-9)

    plt2a, Vvec, zV, zVopt_full, zVopt_low, zVopt_high =
        fig2a_constant_volume_curve(p; Vgrid=Vgrid, periodic_tol=periodic_tol)

    plt4d, As, Ws, Phs, Zs =
        fig4d_A_omega_phi_scatter(p; A_vals=A_vals, ω_vals=ω_vals, ϕ_vals=ϕ_vals, periodic_tol=periodic_tol)

    # label panels (a) and (b)
    plot!(plt2a, title="(a) Steady-state RNA vs fixed V")
    plot!(plt4d, title="(b) 4D scan: (A, ω, ϕ) color = steady RNA")

    combo = plot(plt2a, plt4d; layout=(1,2), size=(2000, 850))
    return combo
end


