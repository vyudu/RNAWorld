# -----------------------
# Reaction model (same)
# -----------------------
function rates(n::AbstractVector, V, p)
    α, Cp, αCp, CppC, RNA = n
    k1,k2,k3,k4,k5,c6,Kd,D1 = p
    Vsafe = max(float(V), eps_div)

    r1 = k1 * (αCp^2) / (Vsafe^2)
    r2 = k2 * (α * CppC) / (Vsafe^2)
    r3 = k3 * CppC / Vsafe
    r4 = k4 * (α * Cp) / (Vsafe^2)
    r5 = k5 * αCp / Vsafe
    r6 = c6 * (CppC / Vsafe) / (1 + (Cp + αCp) / (Kd * Vsafe))
    r7 = D1 / Vsafe
    return r1,r2,r3,r4,r5,r6,r7
end

function model!(du, n, p, t, V)
    r1,r2,r3,r4,r5,r6,r7 = rates(n, V, p)
    du[1] = r1 + r5 - r2 - r4
    du[2] = r3 + r5 - r4 + r7
    du[3] = 2r2 - 2r1 + r3 + r4 - r5 + r6
    du[4] = r1 - r2 - r3 - r6
    du[5] = r6 - r7
end

# -------------------------
# Volume control (UPDATED)
# -------------------------
# Configurable clamp bounds:
sinusoidal_V(t, A, ω, ϕ; Vlo=Vmin, Vhi=Vmax) = clamp(Vmean + A*sin(ω*t + ϕ), Vlo, Vhi)

# -------------------------
# Simulation wrappers
# -------------------------
function simulate_sinusoidal_bounds(p::NTuple, n0, tspan, A, ω, ϕ;
                                    Vlo=Vmin, Vhi=Vmax,
                                    abstol=1e-8, reltol=1e-8, saveat=nothing)
    f!(du, u, p_, t) = model!(du, u, p_, t, sinusoidal_V(t, A, ω, ϕ; Vlo=Vlo, Vhi=Vhi))
    prob = ODEProblem(f!, copy(n0), tspan, p)

    if isnothing(saveat)
        sol = solve(prob, TRBDF2(); abstol=abstol, reltol=reltol, maxiters=1e7)
    else
        sol = solve(prob, TRBDF2(); abstol=abstol, reltol=reltol, saveat=saveat, maxiters=1e7)
    end
    return sol
end

function simulate_constant(p::NTuple, n0, tspan, Vconst;
                           abstol=1e-8, reltol=1e-8, saveat=nothing)
    f!(du, u, p_, t) = model!(du, u, p_, t, Vconst)
    prob = ODEProblem(f!, copy(n0), tspan, p)

    if isnothing(saveat)
        sol = solve(prob, TRBDF2(); abstol=abstol, reltol=reltol, maxiters=1e7)
    else
        sol = solve(prob, TRBDF2(); abstol=abstol, reltol=reltol, saveat=saveat, maxiters=1e7)
    end
    return sol
end

# ============================================================
# Steady/periodic metrics
# ============================================================

# (A) Window-average over [t1,t2] using interpolation + trapezoid on a fixed grid
function window_average_RNA(sol; t1=1000.0, t2=1400.0, N=2001)
    t1 = max(t1, sol.t[1])
    t2 = min(t2, sol.t[end])
    if t2 <= t1
        return NaN
    end
    tt = range(t1, t2; length=N)
    s = 0.0
    @inbounds for i in 1:(length(tt)-1)
        a = sol(tt[i])[5]
        b = sol(tt[i+1])[5]
        dt = tt[i+1] - tt[i]
        s += 0.5*(a+b)*dt
    end
    return s/(t2 - t1)
end

# (B1) Check periodic steady state near the end:
#   max over samples of ||c(t) - c(t-T)||_∞ < tol for all species
function periodic_converged(sol, ω; tol=1e-9, nsamples=200)
    if ω <= 0
        return false
    end
    T = 2π/ω
    if sol.t[end] < 2T
        return false
    end

    t_end = sol.t[end]
    t_start = t_end - T
    tt = range(t_start, t_end; length=nsamples)

    maxerr = 0.0
    @inbounds for t in tt
        u_now = sol(t)
        u_prev = sol(t - T)
        err = maximum(abs.(u_now .- u_prev))
        maxerr = max(maxerr, err)
    end
    return maxerr < tol
end

# (B2) Periodic average over the last period
function periodic_average_RNA(sol, ω; N=2001)
    T = 2π/ω
    t_end = sol.t[end]
    t1 = t_end - T
    t2 = t_end
    if t1 < sol.t[1]
        return NaN
    end
    tt = range(t1, t2; length=N)
    s = 0.0
    @inbounds for i in 1:(length(tt)-1)
        a = sol(tt[i])[5]
        b = sol(tt[i+1])[5]
        dt = tt[i+1] - tt[i]
        s += 0.5*(a+b)*dt
    end
    return s/T
end

# Robust steady-state score:
#  - primary: periodic average if periodic converged
#  - fallback: window average 1000-1400
function steady_state_score(sol, ω;
                            periodic_tol=1e-9,
                            use_periodic=true,
                            fallback_window=true)
    if use_periodic && periodic_converged(sol, ω; tol=periodic_tol)
        return periodic_average_RNA(sol, ω)
    elseif fallback_window
        return window_average_RNA(sol; t1=1000.0, t2=1400.0)
    else
        return NaN
    end
end

# ============================================================
# Optimizer: maximize steady-state RNA (UPDATED ω bound + bounded clamps)
# ============================================================

# Search ranges
A_low = 0.0
ϕ_low, ϕ_high = 0.0, 2π
ω_low, ω_high = 0.005, 100.0

# Objective for BlackBoxOptim (minimize negative score)
function objective_steady_bounds(x, p; Vlo=Vmin, Vhi=Vmax, periodic_tol=1e-9)
    A, ω, ϕ = x
    sol = simulate_sinusoidal_bounds(p, n0, tspan_long, A, ω, ϕ;
                                     Vlo=Vlo, Vhi=Vhi, abstol=1e-6, reltol=1e-6)
    if sol.retcode != :Success
        return 1e12
    end
    z = steady_state_score(sol, ω; periodic_tol=periodic_tol, use_periodic=true, fallback_window=true)
    if !isfinite(z)
        return 1e12
    end
    return -z
end

function optimize_steady_sinusoidal_bounds(p;
                                           Vlo=Vmin, Vhi=Vmax,
                                           maxsteps=1200,
                                           periodic_tol=1e-9,
                                           do_local_refine=true)

    # amplitude bound must respect clamp window
    A_high = (Vhi - Vlo)/2
    search_range = [(A_low, A_high), (ω_low, ω_high), (ϕ_low, ϕ_high)]

    res_global = bboptimize(
        x -> objective_steady_bounds(x, p; Vlo=Vlo, Vhi=Vhi, periodic_tol=periodic_tol);
        Method = :adaptive_de_rand_1_bin_radiuslimited,
        SearchRange = search_range,
        NumDimensions = 3,
        MaxSteps = maxsteps,
        TraceMode = :silent
    )
    x_best = best_candidate(res_global)

    if !do_local_refine
        Aopt, ωopt, ϕopt = x_best
        sol_final = simulate_sinusoidal_bounds(p, n0, tspan_long, Aopt, ωopt, ϕopt;
                                               Vlo=Vlo, Vhi=Vhi, abstol=1e-8, reltol=1e-8)
        zfinal = steady_state_score(sol_final, ωopt; periodic_tol=periodic_tol, use_periodic=true, fallback_window=true)
        return (Aopt, ωopt, ϕopt), zfinal, sol_final
    end

    lower = [r[1] for r in search_range]
    upper = [r[2] for r in search_range]

    res_local = optimize(
        x -> objective_steady_bounds(x, p; Vlo=Vlo, Vhi=Vhi, periodic_tol=periodic_tol),
        lower, upper, x_best,
        Fminbox(NelderMead()),
        Optim.Options(iterations=600, show_trace=false)
    )

    Aopt, ωopt, ϕopt = res_local.minimizer
    sol_final = simulate_sinusoidal_bounds(p, n0, tspan_long, Aopt, ωopt, ϕopt;
                                           Vlo=Vlo, Vhi=Vhi, abstol=1e-8, reltol=1e-8)
    zfinal = steady_state_score(sol_final, ωopt; periodic_tol=periodic_tol, use_periodic=true, fallback_window=true)

    return (Aopt, ωopt, ϕopt), zfinal, sol_final
end

# ============================================================
# Fig 2a: steady-state RNA vs fixed volume + horizontal references (UPDATED)
# ============================================================

function fig2a_constant_volume_curve(p; Vgrid=range(Vmin, Vmax; length=60), periodic_tol=1e-9)

    # constant V curve
    zV = similar(collect(Vgrid), Float64)
    for (i, V) in enumerate(Vgrid)
        sol = simulate_constant(p, n0, tspan_long, V; abstol=1e-8, reltol=1e-8)
        zV[i] = window_average_RNA(sol; t1=1000.0, t2=1400.0)
    end

    # (1) Vopt within [Vmin, Vmax]
    (_, _, _), zVopt_full, _ = optimize_steady_sinusoidal_bounds(
        p; Vlo=Vmin, Vhi=Vmax, periodic_tol=periodic_tol, maxsteps=1200, do_local_refine=true
    )

    # (2) Vopt within [Vmin, Vmean]
    (_, _, _), zVopt_low, _ = optimize_steady_sinusoidal_bounds(
        p; Vlo=Vmin, Vhi=Vmean, periodic_tol=periodic_tol, maxsteps=1200, do_local_refine=true
    )

    # (3) best constant V in [Vmean, Vmax] (from the curve)
    Vvec = collect(Vgrid)
    idx_hi = findall(v -> v >= Vmean, Vvec)
    zConst_hi = maximum(zV[idx_hi])

    plt = plot(Vgrid, zV, lw=3,
               xlabel="Fixed Volume V",
               ylabel="Steady-state RNA (avg 1000–1400)",
               title="Fig 2a: Steady-state RNA vs Fixed Volume")

    hline!(plt, [zVopt_full], lw=2, ls=:dash,
           label="Vopt steady (Vmin–Vmax): $(round(zVopt_full,digits=3))")
    hline!(plt, [zVopt_low],  lw=2, ls=:dot,
           label="Vopt steady (Vmin–Vmean): $(round(zVopt_low,digits=3))")
    hline!(plt, [zConst_hi],  lw=2, ls=:dashdot,
           label="Best constant V in [Vmean–Vmax]: $(round(zConst_hi,digits=3))")

    return plt, Vgrid, zV, zVopt_full, zVopt_low, zConst_hi
end

# ============================================================
# Fig 2b: ω-ϕ colormap (LOG ω grid, ω up to 100)
# ============================================================

function fig2b_omega_phi_heatmap(p; A_fixed=(Vmax-Vmin)/4,
                                 ω_vals = 10 .^ range(log10(0.01), log10(100.0); length=90),  # LOGSPACE
                                 ϕ_vals = range(0.0, 2π; length=80),
                                 periodic_tol=1e-9)

    Z = Array{Float64}(undef, length(ω_vals), length(ϕ_vals))

    for (iω, ω) in enumerate(ω_vals)
        for (iϕ, ϕ) in enumerate(ϕ_vals)
            sol = simulate_sinusoidal_bounds(p, n0, tspan_long, A_fixed, ω, ϕ;
                                             Vlo=Vmin, Vhi=Vmax, abstol=1e-6, reltol=1e-6)
            if sol.retcode != :Success
                Z[iω, iϕ] = NaN
                continue
            end
            Z[iω, iϕ] = steady_state_score(sol, ω; periodic_tol=periodic_tol, use_periodic=true, fallback_window=true)
        end
    end

    plt = heatmap(ϕ_vals, ω_vals, Z;
                  xlabel="ϕ (phase)",
                  ylabel="ω (angular velocity)",
                  yscale=:log10,
                  title="Fig 2b: Periodic steady-state RNA (color) over (ω, ϕ)\nA = $(round(A_fixed, digits=3))",
                  colorbar_title="RNA steady avg")
    return plt, ω_vals, ϕ_vals, Z
end

# ============================================================
# 4D plot: (A, ω, ϕ) color=steady-state RNA (UPDATED layout)
# ============================================================

function fig4d_A_omega_phi_scatter(p;
                                  A_vals=range(0.0, (Vmax-Vmin)/2; length=11),
                                  ω_vals = 10 .^ range(log10(0.01), log10(100.0); length=35),  # LOGSPACE
                                  ϕ_vals=range(0.0, 2π; length=24),
                                  periodic_tol=1e-9)

    As = Float64[]
    Ws = Float64[]
    Phs = Float64[]
    Zs = Float64[]

    for A in A_vals, ω in ω_vals, ϕ in ϕ_vals
        sol = simulate_sinusoidal_bounds(p, n0, tspan_long, A, ω, ϕ;
                                         Vlo=Vmin, Vhi=Vmax, abstol=1e-6, reltol=1e-6)
        if sol.retcode != :Success
            continue
        end
        z = steady_state_score(sol, ω; periodic_tol=periodic_tol, use_periodic=true, fallback_window=true)
        if isfinite(z)
            push!(As, A); push!(Ws, ω); push!(Phs, ϕ); push!(Zs, z)
        end
    end

    plt = scatter3d(
        As, Ws, Phs;
        marker_z = Zs,
        ms = 5,
        xlabel = "A (amplitude)",
        ylabel = "ω (angular velocity)",
        zlabel = "ϕ (phase)",
        title = "4D view: (A, ω, ϕ) with color = steady-state RNA",
        colorbar_title = "RNA steady avg",
        size = (1100, 800),
        right_margin = 18mm,   # extra space so z-label doesn't collide with colorbar
        left_margin  = 8mm,
        bottom_margin = 8mm,
        top_margin = 8mm,
        guidefontsize = 12,
        tickfontsize = 10,
        colorbar_tickfontsize = 9,
        legend = false,
        camera = (45, 25)
    )

    return plt, As, Ws, Phs, Zs
end

