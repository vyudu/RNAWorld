function plot_best_timeseries(sol, A, ω, ϕ; ptitle="Best control", Vlo=Vmin, Vhi=Vmax)
    tt = range(tspan_long[1], tspan_long[2]; length=2000)
    Vt = [sinusoidal_V(t, A, ω, ϕ; Vlo=Vlo, Vhi=Vhi) for t in tt]
    RNA = [sol(t)[5] for t in tt]

    plt1 = plot(tt, Vt, lw=3, xlabel="Time", ylabel="V(t)", title="$ptitle: V(t)")
    plt2 = plot(tt, RNA, lw=3, xlabel="Time", ylabel="RNA", title="$ptitle: RNA(t)")
    return plot(plt1, plt2; layout=(2,1), size=(900,700))
end

